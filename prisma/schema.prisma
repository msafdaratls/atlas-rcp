generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrganisationType {
  CLIENT
  ATLAS
}

enum ClientCategory {
  COMPANY
  INDIVIDUAL
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Role {
  CLIENT_OWNER
  CLIENT_ADMIN
  CLIENT_USER
  CLIENT_FINANCE
  INTAKE_OFFICER
  EVALUATOR
  TECHNICAL_REVIEWER
  DECISION_MAKER
  FINANCE
  CATALOGUE_MANAGER
  QUALITY_MANAGER
  SYSTEM_ADMIN
}

enum RequestState {
  DRAFT
  SUBMITTED
  UNDER_INTAKE_REVIEW
  RETURNED_TO_CLIENT
  ACCEPTED
  ASSESSMENT_QUEUED
  ASSESSMENT_RUNNING
  TECHNICAL_REVIEW
  DECISION
  REPORT_ISSUED
  CLOSED
  CANCELLED
  ON_HOLD
}

enum AvStatus {
  PENDING
  CLEAN
  INFECTED
}

enum CommentDirection {
  ATLAS_TO_CLIENT
  CLIENT_TO_ATLAS
  INTERNAL
}

enum ReturnReasonCode {
  MISSING_ARTWORK
  ILLEGIBLE_SCAN
  LOW_RESOLUTION
  WRONG_PRODUCT_TYPE
  MISSING_COA
  MISSING_FORMULA
  INCOMPLETE_FORMULA
  EXPIRED_DOCUMENT
  WRONG_LANGUAGE
  MISMATCHED_PRODUCT
  OTHER
}

enum FaultAttribution {
  CLIENT_FAULT
  ATLAS_FAULT
  REGULATORY_CHANGE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  CREDIT_NOTE
  REFUND
  ADJUSTMENT
  WRITE_OFF
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CREDIT_NOTE
}

enum PaymentStatus {
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum CouponAppliesTo {
  ALL
  MAIN_CATEGORY
  SUB_CATEGORY
  SERVICE_ITEM
}

enum CouponClientScope {
  ALL
  SPECIFIC
  NEW_CLIENTS_ONLY
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum ReopenRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Organisation & users ────────────────────────────────────────────────────

model Organisation {
  id                    String             @id @default(cuid())
  type                  OrganisationType
  /// Only meaningful when type = CLIENT; null for the ATLAS organisation itself.
  clientCategory        ClientCategory?
  /// Company clients only: skips the Saudi CR/VAT/national-address requirement
  /// and is unique by email instead of by crNumber.
  isInternational       Boolean            @default(false)
  nameEn                String
  nameAr                String
  logoKey               String?
  email                 String
  phone                 String?
  website               String?
  crNumber              String?
  vatNumber             String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postalCode            String?
  country               String             @default("SA")
  nationalAddress       String?
  creditLimit           Decimal            @default(0) @db.Decimal(14, 2)
  /// When true, new client submissions should be blocked once balance exceeds creditLimit.
  autoHoldWhenOverLimit Boolean            @default(false)
  paymentTermsDays      Int                @default(0)
  status                OrganisationStatus @default(ACTIVE)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  users                  User[]
  requests               Request[]
  invoices               Invoice[]
  ledgerEntries          LedgerEntry[]
  payments               Payment[]
  couponRedemptions      CouponRedemption[]
  auditLogs              AuditLog[]
  platformCredentials    PlatformCredential[]
  engagements            Engagement[]
  assistantConversations AssistantConversation[]

  @@unique([crNumber])
  @@index([type, status])
}

model User {
  id                  String     @id @default(cuid())
  organisationId      String
  email               String     @unique
  username            String     @unique
  passwordHash        String
  fullNameEn          String
  fullNameAr          String
  phone               String?    @unique
  avatarKey           String?
  locale              String     @default("ar")
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())

  organisation       Organisation        @relation(fields: [organisationId], references: [id])
  roles              UserRole[]
  verificationTokens VerificationToken[]

  createdRequests          Request[]                 @relation("RequestCreatedBy")
  assignedRequests         Request[]                 @relation("RequestAssignedTo")
  uploadedVersions         DocumentVersion[]
  requestEvents            RequestEvent[]
  requestComments          RequestComment[]
  commentMentions          RequestCommentMention[]
  reopenRequestsMade       RequestReopenRequest[]    @relation("ReopenRequestedBy")
  reopenRequestsDecided    RequestReopenRequest[]    @relation("ReopenRequestDecidedBy")
  activitiesAssigned       RequestItemActivity[]     @relation("ActivityAssignedTo")
  activitiesCreated        RequestItemActivity[]     @relation("ActivityCreatedBy")
  ledgerEntries            LedgerEntry[]
  confirmedPayments        Payment[]                 @relation("PaymentConfirmedBy")
  createdCoupons           Coupon[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  auditLogs                AuditLog[]
  createdCredentials       PlatformCredential[]
  externalDeliverablesMade ExternalDeliverable[]
  createdEngagements       Engagement[]
  defaultEvaluatorFor      ServiceItem[]             @relation("ServiceItemDefaultEvaluator")
  requiredTestsAdded       RequestItemRequiredTest[]
  assistantConversation    AssistantConversation?

  @@index([organisationId])
  @@index([status])
}

model UserRole {
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model NotificationPreference {
  id           String  @id @default(cuid())
  userId       String
  eventType    String
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@index([userId])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model MainCategory {
  id        String  @id @default(cuid())
  code      String  @unique
  nameEn    String
  nameAr    String
  descEn    String?
  descAr    String?
  icon      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  subCategories SubCategory[]
}

model SubCategory {
  id             String  @id @default(cuid())
  mainCategoryId String
  code           String
  nameEn         String
  nameAr         String
  descEn         String?
  descAr         String?
  sortOrder      Int     @default(0)
  active         Boolean @default(true)

  mainCategory MainCategory  @relation(fields: [mainCategoryId], references: [id])
  serviceItems ServiceItem[]

  @@unique([mainCategoryId, code])
  @@index([mainCategoryId, sortOrder])
}

model ServiceItem {
  id                         String          @id @default(cuid())
  subCategoryId              String
  code                       String
  nameEn                     String
  nameAr                     String
  descEn                     String?
  descAr                     String?
  basePrice                  Decimal         @db.Decimal(14, 2)
  vatRate                    Decimal         @default(0.15) @db.Decimal(5, 4)
  resubmissionPricePct       Decimal         @default(0.50) @db.Decimal(5, 4)
  slaHours                   Int
  freeResubmissions          Int             @default(0)
  maxResubmissions           Int             @default(3)
  /// JSON Schema describing product attributes collected at request time.
  productAttrSchema          Json            @default("{}")
  /// Requirement sets shown in "What we check" [{ code, titleEn, titleAr }]
  checkSets                  Json            @default("[]")
  /// Optional evaluation activities: when true, the corresponding
  /// RequestItemActivity card is offered during ASSESSMENT_RUNNING.
  requiresInspection         Boolean         @default(false)
  requiresLabTesting         Boolean         @default(false)
  requiresFactoryAudit       Boolean         @default(false)
  /// Client-facing label for what this service produces, e.g. "Shipment
  /// Certificate of Conformity (SCOC)" — shown on the catalogue/service card.
  deliverableEn              String?
  deliverableAr              String?
  /// INTERNAL_REPORT: Atlas issues its own report at REPORT_ISSUED (the
  /// default, existing flow). EXTERNAL_CERTIFICATE: the deliverable is a
  /// certificate/number obtained from an external portal (SABER/GHAD/FASAH)
  /// or lab — tracked via ExternalDeliverable instead of an internal review.
  deliverableType            DeliverableType @default(INTERNAL_REPORT)
  /// Set when this service needs a client PlatformCredential selected at
  /// request time (e.g. GHAD Product Registration needs a GHAD login). Null
  /// for services with no external-portal login requirement.
  requiredCredentialPlatform PlatformType?
  /// Evaluator this service auto-routes to when Application Review is
  /// completed ("assign to the appropriate Evaluator based on service
  /// type"). Null means the request lands unassigned in the Evaluator queue.
  defaultEvaluatorId         String?
  sortOrder                  Int             @default(0)
  active                     Boolean         @default(true)

  subCategory          SubCategory           @relation(fields: [subCategoryId], references: [id])
  defaultEvaluator     User?                 @relation("ServiceItemDefaultEvaluator", fields: [defaultEvaluatorId], references: [id])
  requiredDocuments    RequiredDocument[]
  requestItems         RequestItem[]
  engagements          Engagement[]
  technicalRegulations TechnicalRegulation[]
  regulationImports    RegulationImport[]

  @@unique([subCategoryId, code])
  @@index([subCategoryId, active, sortOrder])
  @@index([defaultEvaluatorId])
}

/// Single global reviewer meta-checklist (Evaluation Report reviewed /
/// standards verified / etc.) shown during Technical Review — distinct from
/// ServiceItem.checkSets, which is a per-service product-compliance
/// checklist scored during Evaluation/Technical Review. Same CheckSet[] JSON
/// shape and scoring engine (src/lib/assessment.ts), different storage
/// location: one row for the whole platform, not one per catalogue item.
/// Enforced as a singleton by always reading/writing id "singleton".
model TechnicalReviewChecklist {
  id              String   @id @default("singleton")
  checkSets       Json     @default("[]")
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}

enum StandardKind {
  GENERAL
  SPECIFIC
}

enum AssessmentDecisionDb {
  ACCEPTED
  ACCEPTED_WITH_REMARKS
  REJECTED
  INCOMPLETE
}

/// One technical regulation (e.g. a SABER product-safety regulation) under
/// which a set of customs tariff items (HS codes) is evaluated. Scoped to a
/// single ServiceItem (SAB-001 PCOC or SFDA-COS-002 Cosmetics SCOC today).
/// generalChecklist/labelingChecklist are CheckSet[] JSON templates (same
/// shape/engine as TechnicalReviewChecklist, src/lib/assessment.ts) defined
/// once here and reused — answered fresh — by every request under this
/// regulation, rather than duplicated per request.
model TechnicalRegulation {
  id                 String   @id @default(cuid())
  serviceItemId      String
  code               String
  titleEn            String
  titleAr            String
  generalChecklist   Json     @default("[]")
  labelingChecklist  Json     @default("[]")
  /// Required-documents verification checklist (CheckSet[]), answered
  /// Compliant/Non-compliant/N-A by the evaluator during the evaluation.
  /// Deliberately NOT the same thing as ServiceItem.requiredDocuments, which
  /// are the client-facing upload slots collected at intake: this list is
  /// "the evaluator confirms document X is present and valid", the upload
  /// slots are "the client must attach file X".
  documentsChecklist Json     @default("[]")
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  updatedAt          DateTime @updatedAt
  updatedByUserId    String?

  serviceItem ServiceItem        @relation(fields: [serviceItemId], references: [id])
  tariffItems TariffItem[]
  standards   Standard[]
  evaluations TariffEvaluation[]
  imports     RegulationImport[]

  @@unique([serviceItemId, code])
  @@index([serviceItemId, active])
}

/// A general or specific standard under a TechnicalRegulation. checklist is
/// a CheckSet[] JSON template — for SPECIFIC standards this starts empty
/// ("[]") and is filled in by the Certificate of Conformity team once they
/// adopt the standard's actual test content.
model Standard {
  id                    String       @id @default(cuid())
  technicalRegulationId String
  code                  String
  titleEn               String
  titleAr               String
  kind                  StandardKind
  checklist             Json         @default("[]")
  /// Soft-retirement. Workbook imports never delete rows (an incomplete
  /// sheet must not be able to wipe the catalog), so withdrawing a standard
  /// is done by flipping this instead.
  active                Boolean      @default(true)
  updatedAt             DateTime     @updatedAt
  updatedByUserId       String?

  technicalRegulation TechnicalRegulation  @relation(fields: [technicalRegulationId], references: [id])
  tariffItemLinks     TariffItemStandard[]

  @@unique([technicalRegulationId, code])
  @@index([technicalRegulationId, kind])
}

/// A single customs tariff item (12-digit HS code) under a
/// TechnicalRegulation, resolving to its specific standard(s), required
/// certificates, and a conformity assessment module.
model TariffItem {
  id                    String   @id @default(cuid())
  technicalRegulationId String
  hsCode                String
  productTitleEn        String
  productTitleAr        String
  requiredCertificates  String[] @default([])
  conformityModule      String?
  /// Soft-retirement — see Standard.active.
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)

  technicalRegulation TechnicalRegulation  @relation(fields: [technicalRegulationId], references: [id])
  /// SPECIFIC standards for this item. Many-to-many because a product can
  /// carry several (e.g. Aluminium Household Articles → SASO-369 + EN-601 +
  /// EN-602), each rendered as its own checklist section. GENERAL standards
  /// are NOT here: they apply to every product under the regulation and are
  /// read from TechnicalRegulation.standards (kind: GENERAL).
  specificStandards   TariffItemStandard[]
  evaluations         TariffEvaluation[]

  @@unique([technicalRegulationId, hsCode])
  @@index([technicalRegulationId])
}

/// Join between a tariff item and one of its SPECIFIC standards. Explicit
/// (not an implicit m2m) so link order is stable and the join is queryable.
model TariffItemStandard {
  tariffItemId String
  standardId   String
  sortOrder    Int    @default(0)

  tariffItem TariffItem @relation(fields: [tariffItemId], references: [id], onDelete: Cascade)
  standard   Standard   @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([tariffItemId, standardId])
  @@index([standardId])
}

/// Per-request-item runtime record of a tariff-driven evaluation.
///
/// `templateSnapshot` pins the exact checklists this evaluation is judged
/// against, written when the tariff item is selected. Everything at runtime
/// — panel render, verdict save, completion scoring — reads the snapshot,
/// never the live catalog, so a later workbook import can never alter an
/// evaluation that is already under way or finished. Re-selecting a
/// different regulation/tariff item re-snapshots; "refresh to latest
/// catalog" is an explicit, separate action.
///
/// `sectionVerdicts` is Record<sectionKey, AssessmentState> keyed by
/// "general" | "labeling" | "documents" | "std:<standardId>". One map per
/// section rather than one shared map, because an item code is only unique
/// within its own standard — sharing a map lets one answer satisfy a
/// same-coded item in another section and be counted twice.
model TariffEvaluation {
  id                    String                @id @default(cuid())
  requestItemId         String                @unique
  technicalRegulationId String
  tariffItemId          String
  sectionVerdicts       Json                  @default("{}")
  templateSnapshot      Json?
  snapshotAt            DateTime?
  finalDecision         AssessmentDecisionDb?
  completedAt           DateTime?
  updatedAt             DateTime              @updatedAt
  updatedByUserId       String?

  requestItem         RequestItem         @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  tariffItem          TariffItem          @relation(fields: [tariffItemId], references: [id])
  technicalRegulation TechnicalRegulation @relation(fields: [technicalRegulationId], references: [id])

  @@index([tariffItemId])
  @@index([technicalRegulationId])
}

enum RegulationImportStatus {
  PENDING
  APPLIED
  DISCARDED
}

/// One uploaded regulation workbook, staged for review before it touches the
/// catalog. Upload parses + validates + diffs and stores the result here as
/// PENDING; a separate explicit Apply runs the writes from `payload`. Rows
/// are retained after apply as the catalog's change history ("what was
/// updated, by whom, on which date").
model RegulationImport {
  id                    String                 @id @default(cuid())
  serviceItemId         String
  /// Regulation code declared in the workbook. The regulation row may not
  /// exist yet — this import may be creating it.
  regulationCode        String
  technicalRegulationId String?
  sourceFilename        String
  /// The uploaded workbook itself, retained for audit.
  storageKey            String
  checksum              String
  /// Catalog state at preview time; re-checked at apply so a preview built
  /// against since-changed data is refused rather than applied blindly.
  catalogFingerprint    String
  payload               Json
  diff                  Json
  warnings              String[]               @default([])
  status                RegulationImportStatus @default(PENDING)
  error                 String?
  uploadedByUserId      String
  uploadedAt            DateTime               @default(now())
  appliedByUserId       String?
  appliedAt             DateTime?

  serviceItem         ServiceItem          @relation(fields: [serviceItemId], references: [id])
  technicalRegulation TechnicalRegulation? @relation(fields: [technicalRegulationId], references: [id])

  @@index([serviceItemId, uploadedAt])
  @@index([status])
}

enum DeliverableType {
  INTERNAL_REPORT
  EXTERNAL_CERTIFICATE
}

model RequiredDocument {
  id                     String   @id @default(cuid())
  serviceItemId          String
  code                   String
  nameEn                 String
  nameAr                 String
  mandatory              Boolean  @default(true)
  acceptedMimeTypes      String[]
  maxSizeMb              Int      @default(50)
  helpEn                 String?
  helpAr                 String?
  /// Set once an admin uploads a blank form via catalogue:manage; null means
  /// no downloadable template is available for this document slot yet.
  templateStorageKey     String?
  templateFileName       String?
  templateMimeType       String?
  /// Names the productAttrSchema key whose value picks one of `templates`
  /// below — e.g. "technical_regulation" on SAB-001's risk assessment, where
  /// each SABER technical regulation has its own blank form. Null means this
  /// slot has a single template (templateStorageKey) or none at all.
  templateVariantAttrKey String?
  sortOrder              Int      @default(0)

  serviceItem      ServiceItem                @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  requestDocuments RequestDocument[]
  templates        RequiredDocumentTemplate[]

  @@unique([serviceItemId, code])
  @@index([serviceItemId, sortOrder])
}

/// One blank form per value of the parent's `templateVariantAttrKey`. Used
/// where a single document slot needs a different form depending on the
/// product — SAB-001 accepts one risk assessment per product, but which form
/// to fill depends on the product's technical regulation.
model RequiredDocumentTemplate {
  id                 String @id @default(cuid())
  requiredDocumentId String
  /// Matches a value of the parent's templateVariantAttrKey attribute
  /// (e.g. "TEXTILE"). Case-sensitive, compared exactly.
  variantKey         String
  storageKey         String
  fileName           String
  mimeType           String
  sortOrder          Int    @default(0)

  requiredDocument RequiredDocument @relation(fields: [requiredDocumentId], references: [id], onDelete: Cascade)

  @@unique([requiredDocumentId, variantKey])
  @@index([requiredDocumentId, sortOrder])
}

// ─── Requests ────────────────────────────────────────────────────────────────

model Request {
  id                       String        @id @default(cuid())
  requestNo                String        @unique
  organisationId           String
  createdByUserId          String
  assignedToUserId         String?
  /// Set when this request was opened under a standing Engagement (e.g. a
  /// SABER Account Management retainer) rather than as a stand-alone order.
  engagementId             String?
  state                    RequestState  @default(DRAFT)
  /// Prior state when moved to ON_HOLD; resume must return here.
  heldFromState            RequestState?
  submissionNo             Int           @default(1)
  /// Order-level totals: sum of all RequestItem prices, minus the single
  /// order-wide coupon discount (a coupon applies once to the whole order).
  priceCharged             Decimal       @default(0) @db.Decimal(14, 2)
  discountApplied          Decimal       @default(0) @db.Decimal(14, 2)
  couponCode               String?
  /// Client-supplied key; submitRequest is idempotent on this value.
  idempotencyKey           String?       @unique
  slaDueAt                 DateTime?
  /// When set, SLA clock is paused (ON_HOLD / RETURNED_TO_CLIENT).
  slaPausedAt              DateTime?
  submittedAt              DateTime?
  closedAt                 DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  /// Technical Reviewer's meta-checklist results (was the evaluation report
  /// reviewed / standards verified / etc.) — request-level, not per item,
  /// scored against the single global TechnicalReviewChecklist definition.
  /// Same AssessmentState JSON shape as RequestItem.assessment.
  technicalReviewChecklist Json?         @default("{}")
  /// Evaluator confirmation that the certificate issued on the SABER system
  /// has been uploaded to this request (e.g. PCOC/SAB-001, which has no
  /// EXTERNAL_CERTIFICATE deliverable of its own). Gates REPORT_ISSUED ->
  /// CLOSED for such requests, alongside the existing EXTERNAL_CERTIFICATE
  /// document check.
  saberCertificateUploaded Boolean       @default(false)

  organisation   Organisation           @relation(fields: [organisationId], references: [id])
  createdBy      User                   @relation("RequestCreatedBy", fields: [createdByUserId], references: [id])
  assignedTo     User?                  @relation("RequestAssignedTo", fields: [assignedToUserId], references: [id])
  engagement     Engagement?            @relation(fields: [engagementId], references: [id])
  items          RequestItem[]
  documents      RequestDocument[]
  events         RequestEvent[]
  comments       RequestComment[]
  invoices       Invoice[]
  redemptions    CouponRedemption[]
  reopenRequests RequestReopenRequest[]

  @@index([organisationId, state])
  @@index([state, slaDueAt])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([engagementId])
}

/// One service item within a request's cart. A request always has at least
/// one item; multiple items let a client bundle several services (possibly
/// from different subcategories) into a single request/invoice.
model RequestItem {
  id                   String            @id @default(cuid())
  requestId            String
  serviceItemId        String
  productNameEn        String            @default("")
  productNameAr        String            @default("")
  brand                String?
  productAttrs         Json              @default("{}")
  /// Technical-review verdicts per check item: { verdicts, notes, updatedAt, updatedByUserId }.
  assessment           Json              @default("{}")
  /// Snapshot of the service item's price/VAT at the time it was added, so
  /// later catalogue price changes don't retroactively alter an open draft.
  basePrice            Decimal           @db.Decimal(14, 2)
  vatRate              Decimal           @db.Decimal(5, 4)
  sortOrder            Int               @default(0)
  /// Reference to the org's stored government-portal login (GHAD/SABER/FASAH)
  /// used for this item's external submission. Kept out of productAttrs so a
  /// loosely-typed JSON blob never carries a secret reference.
  platformCredentialId String?
  /// Optional traceability link: when this item's required info was produced
  /// by an earlier item (e.g. a FASEH Request# from a FASAH Certificate
  /// Application feeding a Cosmetic SCOC), point at that item. Convenience
  /// only — not a hard validation gate, since a number can also be entered
  /// manually if it originated outside this system.
  sourceRequestItemId  String?
  /// Chosen evaluation route for this item — AI (Label Evaluator) or MANUAL
  /// (manual evaluation page). Set at intake acceptance and changeable by the
  /// Evaluator; null means nobody has chosen yet, in which case both routes
  /// stay offered.
  assessmentMethod     AssessmentMethod?

  request              Request                   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceItem          ServiceItem               @relation(fields: [serviceItemId], references: [id])
  platformCredential   PlatformCredential?       @relation(fields: [platformCredentialId], references: [id])
  sourceRequestItem    RequestItem?              @relation("ItemInputSource", fields: [sourceRequestItemId], references: [id])
  suppliedToItems      RequestItem[]             @relation("ItemInputSource")
  documents            RequestDocument[]
  activities           RequestItemActivity[]
  externalDeliverables ExternalDeliverable[]
  /// Label Evaluator runs against this item (src/server/label-eval). Optional
  /// on the LabelAssessment side with onDelete: SetNull — this back-relation
  /// adds no column here, so draft-cart item deletion is unaffected.
  labelAssessments     LabelAssessment[]
  /// Admin-curated Lab Testing "required tests" checklist (LAB-001 only).
  requiredTests        RequestItemRequiredTest[]
  /// Tariff-driven evaluation run (SAB-001/SFDA-COS-002 only) — see
  /// TariffEvaluation.
  tariffEvaluation     TariffEvaluation?

  @@index([requestId])
  @@index([platformCredentialId])
  @@index([sourceRequestItemId])
  @@index([serviceItemId])
}

model RequestDocument {
  id                    String   @id @default(cuid())
  requestId             String
  requestItemId         String
  requiredDocumentId    String?
  /// Set when this document is a report attached to an evaluation activity
  /// (Inspection/Lab/Audit report) rather than a catalogue-required document.
  activityId            String?
  /// Set when this document is the certificate/report attached to an
  /// external deliverable (SABER/GHAD/FASAH certificate, external lab report).
  externalDeliverableId String?
  label                 String
  currentVersionId      String?  @unique
  createdAt             DateTime @default(now())

  request             Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestItem         RequestItem          @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  requiredDocument    RequiredDocument?    @relation(fields: [requiredDocumentId], references: [id])
  activity            RequestItemActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  externalDeliverable ExternalDeliverable? @relation(fields: [externalDeliverableId], references: [id], onDelete: Cascade)
  currentVersion      DocumentVersion?     @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])
  versions            DocumentVersion[]    @relation("DocumentVersions")

  @@index([requestId])
  @@index([requestItemId])
  @@index([activityId])
  @@index([externalDeliverableId])
}

enum EvaluationActivityType {
  SHIPMENT_INSPECTION
  LABORATORY_TESTING
  FACTORY_AUDIT
}

enum EvaluationActivityStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

/// Shipment Inspection / Laboratory Testing / Factory Audit — optional,
/// per-service evaluation activities scheduled during ASSESSMENT_RUNNING.
/// "Under Inspection" / "Under Audit" sub-status badges are derived from
/// `status === IN_PROGRESS` for the matching type; there is no dedicated
/// RequestState for them. For LABORATORY_TESTING, IN_PROGRESS ("Under
/// testing") is set by confirmSampleReceived rather than on schedule-save —
/// see scheduleEvaluationActivity's type check.
model RequestItemActivity {
  id                String                   @id @default(cuid())
  requestItemId     String
  type              EvaluationActivityType
  status            EvaluationActivityStatus @default(SCHEDULED)
  scheduledDate     DateTime?
  assignedUserId    String?
  qualificationNote String?
  notes             String?
  /// LABORATORY_TESTING only: the accredited lab samples were sent to.
  laboratoryId      String?
  /// LABORATORY_TESTING only: sample shipment tracking.
  sampleTrackingNo  String?
  sampleCarrier     String?
  sampleSentAt      DateTime?
  sampleReceivedAt  DateTime?
  createdByUserId   String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  requestItem  RequestItem       @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  assignedUser User?             @relation("ActivityAssignedTo", fields: [assignedUserId], references: [id])
  createdBy    User              @relation("ActivityCreatedBy", fields: [createdByUserId], references: [id])
  laboratory   Laboratory?       @relation(fields: [laboratoryId], references: [id])
  documents    RequestDocument[]

  @@index([requestItemId, type])
  @@index([laboratoryId])
}

/// Accredited external laboratory a Lab Testing (LAB-001) sample can be sent
/// to. Managed via its own admin CRUD screen (laboratories:manage).
model Laboratory {
  id                   String   @id @default(cuid())
  code                 String   @unique
  nameEn               String
  nameAr               String
  accreditationScopeEn String?
  accreditationScopeAr String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  activities RequestItemActivity[]

  @@index([active, sortOrder])
}

/// Reference catalogue of lab test types, used to build a request item's
/// structured "required tests" checklist (RequestItemRequiredTest). Managed
/// via its own admin CRUD screen (laboratories:manage).
model TestType {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameAr    String
  descEn    String?
  descAr    String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requiredTests RequestItemRequiredTest[]

  @@index([active, sortOrder])
}

/// Admin-curated "required tests" checklist for a Lab Testing request item —
/// the structured counterpart to the client's free-text
/// productAttrs.required_tests, reviewed/identified during Application
/// Review before a laboratory is selected.
model RequestItemRequiredTest {
  id              String   @id @default(cuid())
  requestItemId   String
  testTypeId      String?
  /// Set when the admin needs a test not in the TestType catalogue.
  customLabel     String?
  notes           String?
  createdByUserId String
  createdAt       DateTime @default(now())

  requestItem RequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  testType    TestType?   @relation(fields: [testTypeId], references: [id])
  createdBy   User        @relation(fields: [createdByUserId], references: [id])

  @@index([requestItemId])
  @@index([testTypeId])
}

enum ExternalDeliverableStatus {
  PENDING_SUBMISSION
  SUBMITTED
  ISSUED
  REJECTED
}

/// The external-work analogue of RequestItemActivity: tracks a
/// certificate/registration/report obtained from an outside government
/// portal (SABER, GHAD, FASAH) or an external accredited lab, as opposed to
/// an internal Atlas technical review. `externalRefValue` (e.g. a FASEH
/// Request# or PCOC number) is what a later RequestItem can pull in via
/// RequestItem.sourceRequestItemId.
model ExternalDeliverable {
  id               String                    @id @default(cuid())
  requestItemId    String
  status           ExternalDeliverableStatus @default(PENDING_SUBMISSION)
  /// e.g. "FASEH_REQUEST_NO", "PCOC_NUMBER", "GHAD_NOTIFICATION_NO".
  externalRefType  String
  externalRefValue String?
  submittedAt      DateTime?
  issuedAt         DateTime?
  notes            String?
  createdByUserId  String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  requestItem RequestItem       @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  createdBy   User              @relation(fields: [createdByUserId], references: [id])
  documents   RequestDocument[]

  @@index([requestItemId, status])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  version          Int
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  sha256           String
  uploadedByUserId String
  avStatus         AvStatus @default(PENDING)
  uploadedAt       DateTime @default(now())

  document   RequestDocument  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User             @relation(fields: [uploadedByUserId], references: [id])
  currentFor RequestDocument? @relation("CurrentDocumentVersion")

  @@unique([documentId, version])
  @@index([documentId, uploadedAt])
  @@index([sha256])
}

model RequestEvent {
  id               String             @id @default(cuid())
  requestId        String
  fromState        RequestState?
  toState          RequestState
  actorUserId      String
  actorRole        Role
  note             String?
  reasonCodes      ReturnReasonCode[] @default([])
  faultAttribution FaultAttribution?
  metadata         Json               @default("{}")
  createdAt        DateTime           @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorUserId], references: [id])

  @@index([requestId, createdAt])
  @@index([toState, createdAt])
}

model RequestComment {
  id           String            @id @default(cuid())
  requestId    String
  authorUserId String
  direction    CommentDirection
  reasonCode   ReturnReasonCode?
  bodyEn       String?
  bodyAr       String?
  attachments  Json              @default("[]")
  readAt       DateTime?
  createdAt    DateTime          @default(now())

  request  Request                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author   User                    @relation(fields: [authorUserId], references: [id])
  mentions RequestCommentMention[]

  @@index([requestId, createdAt])
}

/// A user mentioned via @[Name](userId) inside an internal note's body.
model RequestCommentMention {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment RequestComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

/// Client-initiated request to reopen a CLOSED/CANCELLED request; admin approves
/// (choosing the destination stage) or rejects. A direct admin-initiated reopen
/// (no prior client request) is recorded here too, pre-set to APPROVED.
model RequestReopenRequest {
  id                String              @id @default(cuid())
  requestId         String
  status            ReopenRequestStatus @default(PENDING)
  reason            String
  requestedByUserId String
  decidedByUserId   String?
  decisionNote      String?
  /// Stage the request is moved to once approved.
  targetState       RequestState?
  createdAt         DateTime            @default(now())
  decidedAt         DateTime?

  request     Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ReopenRequestedBy", fields: [requestedByUserId], references: [id])
  decidedBy   User?   @relation("ReopenRequestDecidedBy", fields: [decidedByUserId], references: [id])

  @@index([requestId, status])
  @@index([status, createdAt])
}

// ─── Engagements & credentials ─────────────────────────────────────────────────

enum PlatformType {
  GHAD
  SABER
  FASAH
}

enum EngagementStatus {
  ACTIVE
  PAUSED
  CLOSED
}

/// Organisation-scoped, reusable government-portal login (GHAD/SABER/FASAH).
/// Stored once per client per platform rather than re-entered per request —
/// secretCiphertext/secretIv/secretAuthTag are an AES-256-GCM envelope
/// (src/lib/crypto/vault.ts); the raw secret never touches RequestItem or
/// any other JSON blob.
model PlatformCredential {
  id               String       @id @default(cuid())
  organisationId   String
  platform         PlatformType
  label            String?
  loginIdentifier  String
  secretCiphertext String
  secretIv         String
  secretAuthTag    String
  secretKeyVersion String       @default("v1")
  createdByUserId  String
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  createdBy    User          @relation(fields: [createdByUserId], references: [id])
  requestItems RequestItem[]

  @@index([organisationId, platform, active])
}

/// Standing retainer for ongoing-management services (e.g. SABER Account
/// Management): stays ACTIVE while individual child Requests (each PCOC/SCOC
/// submission) open and close normally through the existing RequestState
/// machine. Pure grouping/status wrapper — does not alter Request lifecycle.
/// Keyed by serviceItemId rather than hardcoded to SABER so any future
/// retainer-style service can reuse it.
model Engagement {
  id              String           @id @default(cuid())
  organisationId  String
  serviceItemId   String
  status          EngagementStatus @default(ACTIVE)
  startedAt       DateTime         @default(now())
  closedAt        DateTime?
  notes           String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  serviceItem  ServiceItem  @relation(fields: [serviceItemId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])
  requests     Request[]

  @@index([organisationId, status])
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Invoice {
