# ─── Database ────────────────────────────────────────────────────────────────
# Local dev points at localhost. In docker-compose the app service overrides
# this to reach the `db` service. In production prefer DigitalOcean Managed
# Postgres (automated backups + connection pooling).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlas_rcp?schema=public"

# Used by docker-compose to provision the bundled Postgres.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="atlas_rcp"

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET="generate-a-long-random-secret"
# Public origin of the app. MUST be your https domain in production so secure
# cookies and callback URLs are correct.
AUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Storage ─────────────────────────────────────────────────────────────────
# STORAGE_DRIVER: "local" (default) writes to ./storage/uploads — NOT durable on
# a droplet (lost on redeploy, not backed up). Use "spaces" in production.
STORAGE_DRIVER="local"
STORAGE_ROOT="./storage/uploads"

# DigitalOcean Spaces (required when STORAGE_DRIVER=spaces). Bucket must be
# PRIVATE — downloads are proxied through the auth-gated /api/storage route.
# SPACES_REGION="nyc3"
# SPACES_BUCKET="atlas-rcp-prod"
# SPACES_KEY="..."
# SPACES_SECRET="..."
# SPACES_ENDPOINT="nyc3.digitaloceanspaces.com"   # optional; derived from region

# ─── Platform credentials vault ───────────────────────────────────────────────
# AES-256-GCM key for encrypting client GHAD/SABER/FASAH portal logins
# (src/lib/crypto/vault.ts). Required before any PlatformCredential can be
# saved or read. 32 raw bytes, base64. Generate with: openssl rand -base64 32
CREDENTIALS_MASTER_KEY="generate-with-openssl-rand-base64-32"
# Each stored credential records which key version encrypted it, so the
# master key can be rotated without a hard cutover. To rotate: generate a new
# key, set it as CREDENTIALS_MASTER_KEY_V2 (keep CREDENTIALS_MASTER_KEY around
# — existing rows still need it to decrypt), set CREDENTIALS_MASTER_KEY_VERSION
# to "v2" so new saves use it, then re-save each credential to migrate it
# before retiring the old key.
# CREDENTIALS_MASTER_KEY_VERSION="v1"
# CREDENTIALS_MASTER_KEY_V2="generate-with-openssl-rand-base64-32"

# ─── Email (notification outbox worker) ──────────────────────────────────────
# Dev defaults target a local Mailpit sink (no auth). For production set a real
# ESP (Amazon SES, Postmark, Resend, …) and configure SPF/DKIM/DMARC on the
# sending domain for deliverability.
SMTP_HOST="localhost"
SMTP_PORT="1025"
# SMTP_SECURE="true"      # implicit TLS (port 465); defaults true when port=465
# SMTP_USER="..."
# SMTP_PASS="..."
# SMTP_REJECT_UNAUTHORIZED="true"   # defaults true in production
SMTP_FROM="Atlas Support & Services <noreply@localhost>"

# ─── Antivirus scanning ──────────────────────────────────────────────────────
# AV_DRIVER: "none" (default) accepts uploads without scanning; "clamav" streams
# each upload to a clamd daemon and rejects infected files. A clamd outage fails
# closed (upload rejected) rather than accepting an unscanned file.
AV_DRIVER="none"
# CLAMD_HOST="127.0.0.1"
# CLAMD_PORT="3310"

# ─── Redis (distributed rate limiting) ───────────────────────────────────────
# Optional. With RATE_LIMIT_DRIVER=redis + REDIS_URL, login/verify limits are
# shared across instances. Falls back to in-process (fail-open) on any Redis
# error, so an outage never locks users out. Use a private-network Redis
# (rediss:// TLS is not implemented). Required once you run >1 web instance.
# RATE_LIMIT_DRIVER="redis"
# REDIS_URL="redis://:password@10.0.0.5:6379"

# ─── Background worker ───────────────────────────────────────────────────────
# Notification outbox + SLA / overdue scanners (default ON; set to 0 to disable,
# e.g. on extra web instances when the worker runs as its own process).
# NOTIFICATIONS_WORKER=0

# ─── Label Evaluator AI (SFDA + Cosmetics extraction / judgment-proposal / classification) ─
# ANTHROPIC_API_KEY gates all three AI-assisted steps below. Unset = today's
# exact fallback behavior everywhere (manual field entry, NEEDS_REVIEW on
# judgment items, keyword-based cosmetics classification) — every step fails
# closed, never blocks a reviewer.
# ANTHROPIC_API_KEY="sk-ant-..."
#
# NOTE: the key alone turns on judgment proposals and cosmetics
# classification, but NOT extraction — that one takes BOTH the key and the
# provider switch below, because there are four possible providers and the
# key cannot say which was intended. Setting the key and leaving this at
# "manual" is a working configuration, not a broken one: reviewers keep
# typing label fields in by hand. Set it to "claude" to read them off the
# artwork automatically.
# manual | claude — "claude" also needs ANTHROPIC_API_KEY set, and fails
# closed to "manual" if it isn't.
LABEL_EVAL_EXTRACTION_PROVIDER="manual"
# Model used for label-field extraction (vision). Defaults to claude-sonnet-5.
# LABEL_EVAL_CLAUDE_EXTRACTION_MODEL="claude-sonnet-5"
# Model used for judgment-verdict proposals and cosmetics classification —
# both benefit from the stronger reasoning model. Defaults to claude-opus-5.
# LABEL_EVAL_CLAUDE_JUDGMENT_MODEL="claude-opus-5"

# ─── Assistant chats: AI on/off ────────────────────────────────────────────
# MASTER SWITCH for whether EITHER chat assistant (client or staff) may spend
# Claude tokens. Default (unset) = OFF: both chats answer entirely from
# stored data and cost nothing — the live service catalogue, the live
# knowledge-base rules, and the bilingual stored answer banks in
# src/server/assistant/canned-answers.ts and admin-canned-answers.ts. A
# question none of those resolve gets a reply naming the topics closest to
# what was asked, plus a pointer to Support.
#
# This is deliberately SEPARATE from ANTHROPIC_API_KEY: that key is shared
# with the Label Evaluator AI above, so clearing it to silence the chats
# would also switch off extraction, judgment proposals and classification.
#
# To turn the AI fallback on later, set this to the literal "true" AND have
# ANTHROPIC_API_KEY set — either one alone leaves the chats on stored
# answers. Enabling is purely additive: the stored answers still run first
# and the model only ever sees what they could not resolve.
# ASSISTANT_AI_ENABLED="true"

# ─── Client assistant chat ─────────────────────────────────────────────────
# Everything below applies only while ASSISTANT_AI_ENABLED is "true".
# Most turns still never reach Claude: the stored answer banks and an
# off-topic guard handle them for free before this budget or the per-user
# rate limit (20/hour, hardcoded in actions.ts) are even considered. This is
# the remaining spend ceiling, shared across all clients — once today's total
# input+output tokens hit it, the assistant fails closed to a "try again
# tomorrow" notice until the daily counter resets.
# ASSISTANT_DAILY_TOKEN_BUDGET="1000000"
# Model used for the chat itself. Defaults to claude-sonnet-5.
# ASSISTANT_CLAUDE_MODEL="claude-sonnet-5"

# ─── Admin/staff assistant chat ────────────────────────────────────────────
# Same design as the client assistant above (stored answers + off-topic
# guard before ever spending tokens, and gated on ASSISTANT_AI_ENABLED the
# same way), but for Atlas staff — an independent
# daily budget so heavy admin usage can never eat into the client-facing
# pool, or vice versa. Shares ASSISTANT_CLAUDE_MODEL for the model choice.
# ADMIN_ASSISTANT_DAILY_TOKEN_BUDGET="1000000"
