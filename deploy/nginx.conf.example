# Reverse proxy for the Atlas app on a DigitalOcean droplet.
# Terminates TLS and forwards to the container on :3000. Obtain certificates
# with certbot (or use Caddy for automatic TLS). Replace atlas.example.com.

server {
    listen 80;
    server_name atlas.example.com;
    # Redirect all HTTP to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name atlas.example.com;

    ssl_certificate     /etc/letsencrypt/live/atlas.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/atlas.example.com/privkey.pem;

    # Must be >= serverActions.bodySizeLimit (60mb) for document uploads.
    client_max_body_size 64m;

    # Health probe (bypasses any auth).
    location /api/health {
        proxy_pass http://127.0.0.1:3000;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
